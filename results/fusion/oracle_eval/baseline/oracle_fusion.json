  "protocol": {
    "scale": "oracle_gt_aligned. ORACLE. Every source and the target's own layer are the frame's prediction aligned to that frame's GT, so all results are an upper bound for fusion with estimated scale",
    "targets": "kept-frame indices at window positions 100 to 199 unless --targets or --all-targets is given; sources come from the whole window",
    "sources": "chosen by timestamp with the engine's select_sources over the whole window; diverse stride 100 ms",
    "source_validity": "finite and greater than 0 in the aligned depth; the GT mask is never used for sources",
    "poses": "RGB-timestamp GT poses; the GT ceiling uses depth-timestamp poses for sources and target",
    "scoring": "rel_d and delta1_d x100 with upstream rel_depth and delta1_depth over GT-valid target pixels, no realignment; holes take the target's own aligned depth; rel_d near, mid and far over GT depth thirds; rel_d_covered over GT-valid pixels that are not holes; median_n_sources counts every layer that survived aggregation over GT-valid pixels, the target's own layer included",
    "gt_ceiling": "GT depth (valid where GT is valid) fused with the causal_diverse_w4 settings with and without the target's own GT layer, and with the rung d settings without it; rel_d_covered is also split into interior pixels and pixels inside depth_edge_band of the target GT",
    "controls": "shuffled_poses gives each source the pose of a different random window frame; pose_noise adds per-axis Gaussian noise to source translations (mm) and rotation vectors (deg); both use --seed",
    "regression": "baseline_self rel_d equals per_frame.csv within 0.0001 (absolute, percent) for every target; the cached aligned depth of a few frames per sequence rescored directly equals it within 1e-06, and its stored rel_d within 0.0001"
  },
